{
  "name": "deepwork",
  "productName": "Deepwork",
  "version": "0.2.1",
  "description": "Full focus mode for Windows and macOS: timer, levels, notification mute, site/app blocking, Brave cleanup, planner, journal",
  "main": "main.js",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "start": "electron .",
    "dry": "electron . --dry",
    "shortcut": "electron . --make-shortcut",
    "dist:mac": "npx --yes electron-builder@25 --mac",
    "dist:win": "npx --yes electron-builder@25 --win",
    "test": "node --test \"test/*.test.js\"",
    "check": "node tools/check.js"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "electron": "^44.5.1"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "build": {
    "appId": "com.deepwork.app",
    "productName": "Deepwork",
    "files": [
      "**/*",
      "!docs/**",
      "!tools/**",
      "!extension/**",
      "!*.md"
    ],
    "extraResources": [
      {
        "from": "extension",
        "to": "extension"
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Deepwork"
    }
  }
}
